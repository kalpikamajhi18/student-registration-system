<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: #f5f1f3;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 15px;
        }

        .login-container {
            width: 100%;
            max-width: 850px;
            min-height: 500px;
            background: white;
            border: 1px solid #e5d8de;
            border-radius: 12px;
            display: flex;
            overflow: hidden;
        }

        /* LEFT SECTION */

        .left-section {
            width: 42%;
            background: #5E2D3F;
            color: white;
            padding: 40px 30px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .left-section h1 {
            font-size: 32px;
            margin-bottom: 12px;
        }

        .left-section p {
            font-size: 14px;
            line-height: 1.6;
            color: #f1e5e9;
        }

        .left-box {
            margin-top: 35px;
            border: 1px solid #d9bfc9;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
        }

        .left-box h3 {
            font-size: 18px;
            margin-bottom: 8px;
        }

        .left-box p {
            font-size: 13px;
        }


        /* RIGHT SECTION */

        .right-section {
            width: 58%;
            padding: 50px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .heading {
            text-align: center;
            margin-bottom: 30px;
        }

        .heading h1 {
            color: #5E2D3F;
            font-size: 28px;
            margin-bottom: 7px;
        }

        .heading p {
            color: #777;
            font-size: 13px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: #333;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #d7c9cf;
            border-radius: 6px;
            outline: none;
            font-size: 13px;
        }

        .form-group input:focus {
            border-color: #5E2D3F;
        }

        .login-btn {
            width: 100%;
            padding: 12px;
            margin-top: 5px;
            border: none;
            border-radius: 6px;
            background: #5E2D3F;
            color: white;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

        .login-btn:hover {
            background: #492333;
        }

        .signup-link {
            text-align: center;
            margin-top: 18px;
            font-size: 13px;
            color: #777;
        }

        .signup-link a {
            color: #5E2D3F;
            text-decoration: none;
            font-weight: 600;
        }

        .signup-link a:hover {
            text-decoration: underline;
        }


        /* RESPONSIVE */

        @media (max-width: 700px) {

            .login-container {
                flex-direction: column;
            }

            .left-section {
                width: 100%;
                padding: 30px 20px;
            }

            .left-box {
                display: none;
            }

            .right-section {
                width: 100%;
                padding: 35px 25px;
            }
        }

        @media (max-width: 450px) {

            .right-section {
                padding: 30px 20px;
            }

            .left-section h1 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <div class="login-container">

        <!-- LEFT SECTION -->

        <div class="left-section">

            <h1>Welcome Back!</h1>

            <p>
                Login to your account and continue
                where you left off.
            </p>

            <div class="left-box">

                <h3>Good to see you again</h3>

                <p>
                    Enter your credentials to access
                    your dashboard.
                </p>

            </div>

        </div>


        <!-- RIGHT SECTION -->

        <div class="right-section">

            <div class="heading">

                <h1>Welcome Back</h1>

                <p>Login to your account</p>

            </div>


            <form action="/login" method="POST">

                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                    >

                </div>


                <button type="submit" class="login-btn">
                    Login
                </button>


                <div class="signup-link">

                    Don't have an account?

                    <a href="/">
                        Sign Up
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>
</html>