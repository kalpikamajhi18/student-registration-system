<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sign Up</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: #f5f1f3;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 15px;
        }

        .signup-container {
            width: 100%;
            max-width: 850px;
            min-height: 520px;
            background: white;
            border: 1px solid #e5d8de;
            border-radius: 12px;
            display: flex;
            overflow: hidden;
        }

        /* LEFT SIDE */

        .left-section {
            width: 42%;
            background: #5E2D3F;
            color: white;
            padding: 40px 30px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .left-section h1 {
            font-size: 32px;
            margin-bottom: 12px;
        }

        .left-section p {
            font-size: 14px;
            line-height: 1.6;
            color: #f1e5e9;
        }

        .left-box {
            margin-top: 35px;
            border: 1px solid #d9bfc9;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
        }

        .left-box h3 {
            font-size: 18px;
            margin-bottom: 8px;
        }

        .left-box p {
            font-size: 13px;
        }


        /* RIGHT SIDE */

        .right-section {
            width: 58%;
            padding: 35px 40px;
        }

        .heading {
            text-align: center;
            margin-bottom: 25px;
        }

        .heading h1 {
            color: #5E2D3F;
            font-size: 27px;
            margin-bottom: 7px;
        }

        .heading p {
            color: #777;
            font-size: 13px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            color: #333;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 10px 11px;
            border: 1px solid #d7c9cf;
            border-radius: 6px;
            outline: none;
            font-size: 13px;
            background: white;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #5E2D3F;
        }

        .form-row {
            display: flex;
            gap: 15px;
        }

        .form-row .form-group {
            width: 50%;
        }

        .gender {
            display: flex;
            gap: 20px;
            margin-top: 7px;
        }

        .gender label {
            display: flex;
            align-items: center;
            gap: 5px;
            font-weight: normal;
            cursor: pointer;
        }

        .gender input {
            accent-color: #5E2D3F;
        }

        .signup-btn {
            width: 100%;
            padding: 11px;
            margin-top: 5px;
            border: none;
            border-radius: 6px;
            background: #5E2D3F;
            color: white;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

        .signup-btn:hover {
            background: #492333;
        }

        .login-link {
            text-align: center;
            margin-top: 16px;
            font-size: 13px;
            color: #777;
        }

        .login-link a {
            color: #5E2D3F;
            text-decoration: none;
            font-weight: 600;
        }

        .login-link a:hover {
            text-decoration: underline;
        }


        /* RESPONSIVE */

        @media (max-width: 700px) {

            .signup-container {
                flex-direction: column;
            }

            .left-section {
                width: 100%;
                padding: 25px 20px;
            }

            .left-box {
                display: none;
            }

            .right-section {
                width: 100%;
                padding: 30px 25px;
            }
        }

        @media (max-width: 450px) {

            .right-section {
                padding: 25px 20px;
            }

            .form-row {
                flex-direction: column;
                gap: 0;
            }

            .form-row .form-group {
                width: 100%;
            }

            .gender {
                gap: 12px;
            }

            .left-section h1 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <div class="signup-container">

        <!-- LEFT SECTION -->

        <div class="left-section">

            <h1>Welcome!</h1>

            <p>
                Create your account and get started
                with our platform.
            </p>

            <div class="left-box">
                <h3>Join Us</h3>

                <p>
                    Register your details to access
                    your dashboard.
                </p>
            </div>

        </div>


        <!-- RIGHT SECTION -->

        <div class="right-section">

            <div class="heading">
                <h1>Create Account</h1>
                <p>Register yourself to continue</p>
            </div>


            <form action="/" method="POST">

                <div class="form-row">

                    <div class="form-group">
                        <label for="name">Full Name</label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your name"
                            required
                        >
                    </div>


                    <div class="form-group">
                        <label for="email">Email</label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            required
                        >
                    </div>

                </div>


                <div class="form-row">

                    <div class="form-group">
                        <label for="contact">Contact</label>

                        <input
                            type="tel"
                            id="contact"
                            name="contact"
                            placeholder="Enter contact number"
                            required
                        >
                    </div>


                    <div class="form-group">
                        <label for="age">Age</label>

                        <input
                            type="number"
                            id="age"
                            name="age"
                            placeholder="Enter your age"
                            min="18"
                            required
                        >
                    </div>

                </div>


                <div class="form-group">

                    <label for="city">City</label>

                    <input
                        type="text"
                        id="city"
                        name="city"
                        placeholder="Enter your city"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>Gender</label>

                    <div class="gender">

                        <label>
                            <input
                                type="radio"
                                name="gender"
                                value="Male"
                                required
                            >
                            Male
                        </label>

                        <label>
                            <input
                                type="radio"
                                name="gender"
                                value="Female"
                            >
                            Female
                        </label>

                        <label>
                            <input
                                type="radio"
                                name="gender"
                                value="Other"
                            >
                            Other
                        </label>

                    </div>

                </div>


                <div class="form-group">

                    <label for="password">Password</label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Create a password"
                        required
                    >

                </div>


                <button type="submit" class="signup-btn">
                    Create Account
                </button>


                <div class="login-link">

                    Already have an account?

                    <a href="/login">
                        Login
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>
</html>