<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit User</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: #f5f1f3;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 20px;
        }

        .edit-container {
            width: 100%;
            max-width: 600px;
            background: white;
            border: 1px solid #e5d8de;
            border-radius: 10px;
            padding: 35px;
        }

        .heading {
            margin-bottom: 25px;
        }

        .heading h1 {
            color: #5E2D3F;
            font-size: 27px;
            margin-bottom: 6px;
        }

        .heading p {
            color: #777;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 17px;
        }

        .form-group label {
            display: block;
            color: #444;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .form-group input {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid #d9cbd1;
            border-radius: 6px;
            outline: none;
            font-size: 14px;
            color: #444;
            background: white;
        }

        .form-group input:focus {
            border-color: #5E2D3F;
        }

        .buttons {
            display: flex;
            gap: 12px;
            margin-top: 25px;
        }

        .update-btn {
            flex: 1;
            background: #5E2D3F;
            color: white;
            border: none;
            padding: 11px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

        .update-btn:hover {
            background: #492333;
        }

        .back-btn {
            flex: 1;
            text-align: center;
            text-decoration: none;
            background: #f1e5e9;
            color: #5E2D3F;
            padding: 11px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
        }

        .back-btn:hover {
            background: #e5d8de;
        }

        @media (max-width: 500px) {

            .edit-container {
                padding: 25px 20px;
            }

            .heading h1 {
                font-size: 23px;
            }

            .buttons {
                flex-direction: column;
            }
        }

    </style>

</head>

<body>

    <div class="edit-container">

        <div class="heading">
            <h1>Edit User</h1>
            <p>Update the details of the registered user.</p>
        </div>


        <form action="/user/<%= user._id %>/edit" method="POST">

            <div class="form-group">
                <label>Name</label>

                <input 
                    type="text"
                    name="name"
                    value="<%= user.name %>"
                    required
                >
            </div>


            <div class="form-group">
                <label>Email</label>

                <input 
                    type="email"
                    name="email"
                    value="<%= user.email %>"
                    required
                >
            </div>


            <div class="form-group">
                <label>Contact</label>

                <input 
                    type="text"
                    name="contact"
                    value="<%= user.contact %>"
                    required
                >
            </div>


            <div class="form-group">
                <label>Age</label>

                <input 
                    type="number"
                    name="age"
                    value="<%= user.age %>"
                    min="18"
                    required
                >
            </div>


            <div class="form-group">
                <label>City</label>

                <input 
                    type="text"
                    name="city"
                    value="<%= user.city %>"
                    required
                >
            </div>


            <div class="form-group">
                <label>Gender</label>

                <input 
                    type="text"
                    name="gender"
                    value="<%= user.gender %>"
                    required
                >
            </div>


            <div class="buttons">

                <button type="submit" class="update-btn">
                    Save Changes
                </button>

                <a href="/user/<%= user._id %>" class="back-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</body>

</html>